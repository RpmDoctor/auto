# Binance API Settings
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_API_SECRET=YOUR_API_SECRET_HERE
BINANCE_USE_TESTNET=true

# App Mode (run, check, bot)
APP_MODE=bot

# Trading Settings
TRADING_ENABLE=false
TRADING_DRY_RUN=true
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=1m
TRADING_QUANTITY=0.001
TRADING_LEVERAGE=1
TRADING_USE_EXCHANGE_FILTERS=true

# Risk Management
RISK_STOP_LOSS_PCT=0.5
RISK_TAKE_PROFIT_PCT=0.9
RISK_TRAILING_STOP_PCT=0.3
RISK_DAILY_LOSS_LIMIT_PCT=3.0
RISK_MAX_CONSECUTIVE_LOSSES=5
RISK_MAX_OPEN_POSITIONS=1

# Bot Settings
BOT_MAX_TRADES=0
BOT_LOOP_SECONDS=10
BOT_COOLDOWN_SECONDS=30
BOT_MAX_HOLD_SECONDS=300

# Strategy Settings
STRAT_LOOKBACK=20
STRAT_VOLUME_MULT=1.5
STRAT_MIN_BODY_PCT=0.05
STRAT_RSI_PERIOD=14
STRAT_RSI_LOW=30.0
STRAT_RSI_HIGH=70.0
STRAT_EMA_FAST=20
STRAT_EMA_SLOW=50

# Watchlist Settings
WATCHLIST_MODE=auto
WATCHLIST_SIZE=10
WATCHLIST_MIN_QUOTE_USDT=50000000.0
WATCHLIST_MAX_VOL_PCT_24H=12.0

# Dashboard Settings
DASHBOARD_TRADES_LIMIT=1000
DASHBOARD_CLOSE_ROWS=300
USDT_KRW_RATE=1350

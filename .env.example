# 1. Binance API (Testnet/Live)
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_API_SECRET=YOUR_API_SECRET_HERE
USE_TESTNET=true

# 2. Trading Target
TRADING_SYMBOL=BTCUSDT
TRADING_QUANTITY=0.001
TRADING_LEVERAGE=5
LEVERAGE_MODE=auto  # auto(성과 기반) 또는 manual(고정)
LEVERAGE_MIN=1
LEVERAGE_MAX=10

# 3. Strategy Parameters
STRAT_LOOKBACK=20
STRAT_VOLUME_MULT=1.5
STRAT_MIN_BODY_PCT=0.05
STRAT_RSI_PERIOD=14
STRAT_RSI_LOW=30.0
STRAT_RSI_HIGH=70.0
STRAT_EMA_FAST=20
STRAT_EMA_SLOW=50
STRAT_MACD_FAST=12
STRAT_MACD_SLOW=26
STRAT_MACD_SIGNAL=9

# 4. Risk Management (ATR Based)
RISK_ATR_MULTIPLIER_SL=1.5
RISK_ATR_MULTIPLIER_TP=3.0
RISK_TRAILING_STOP_PCT=0.3
RISK_DAILY_LOSS_LIMIT_PCT=3.0
RISK_MAX_CONSECUTIVE_LOSSES=5
RISK_MAX_OPEN_POSITIONS=1

# 5. Bot & Dashboard Settings
BOT_LOOP_SECONDS=30
BOT_COOLDOWN_SECONDS=60
BOT_MAX_HOLD_SECONDS=3600
TRADING_DRY_RUN=true
TRADING_USE_EXCHANGE_FILTERS=true

WATCHLIST_MODE=auto  # auto(자동 선정) 또는 manual(고정)
WATCHLIST_SIZE=10
WATCHLIST_MIN_QUOTE_USDT=50000000
WATCHLIST_MAX_VOL_PCT_24h=15.0

DASHBOARD_TRADES_LIMIT=50
DASHBOARD_CLOSE_ROWS=20
USDT_KRW_RATE=1350.0
